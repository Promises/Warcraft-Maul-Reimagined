IncludeFile "UI\FrameDef\UI\EscMenuTemplates.fdf",
IncludeFile "UI\FrameDef\Glue\BattleNetTemplates.fdf",
IncludeFile "UI\FrameDef\Glue\StandardTemplates.fdf",

Frame "GLUETEXTBUTTON" "CustomTextButton" INHERITS WITHCHILDREN "EscMenuButtonTemplate" {
    UseActiveContext,
    ButtonText "ScriptDialogButtonText",
	Frame "TEXT" "ScriptDialogButtonText" INHERITS "EscMenuButtonTextTemplate" {
		Text "",
	}
}

// A list row: the same button with its text left-justified and indented past an icon that
// the script places at the left edge. The text is the button's own, so clicks land anywhere
// on the row (a separate TEXT child frame would swallow them).
Frame "GLUETEXTBUTTON" "CustomListButton" INHERITS WITHCHILDREN "EscMenuButtonTemplate" {
    UseActiveContext,
    ButtonText "CustomListButtonText",
	Frame "TEXT" "CustomListButtonText" INHERITS "EscMenuButtonTextTemplate" {
		Text "",
		FontJustificationH JUSTIFYLEFT,
		FontJustificationOffset 0.028 0.0,
		FontFlags "FIXEDSIZE",
		FrameFont "MasterFont", 0.010, "",
	}
}

// -- LOCAL TEMPLATES -------------------------------------------------------
Frame "BACKDROP" "BoxedTextBackgroundTemplate" {
        DecorateFileNames, //Look-Up Names in some String table (for example gameinterface)
        BackdropTileBackground, //Tile mode enabled
        BackdropBackground  "ToolTipBackground", //BackgroundFile
        BackdropCornerFlags "UL|UR|BL|BR|T|L|B|R",
        BackdropCornerSize  0.008, //higher numbers make the corners bigger.
        BackdropBackgroundInsets 0.0022 0.0022 0.0022 0.0022, //makes the background smaller, from the outside.
        BackdropEdgeFile  "ToolTipBorder", //the border File
        BackdropBlendAll,
}
// An icon button: a plain BUTTON with the standard mouse-over glow; the script lays it over an
// icon backdrop as that backdrop's child, so the glow draws over the icon. Hover feedback
// (glow, tooltip) is left to the engine: registering mouse enter/leave events on a frame
// makes the engine reset its hover every tick.
Frame "BUTTON" "CustomIconButton" {
    ControlStyle "AUTOTRACK|HIGHLIGHTONMOUSEOVER",
    ControlMouseOverHighlight "CustomIconButtonHighlight",
    Frame "HIGHLIGHT" "CustomIconButtonHighlight" INHERITS "StandardButtonMouseOverHighlightTemplate" {
    }
}

// Game messages, drawn by GameMessages in place of the hidden ORIGIN_FRAME_UNIT_MSG so that
// our panels can cover them: white, bottom-left justified, with a shadow for the terrain.
Frame "TEXT" "CustomGameMessageText" {
    DecorateFileNames,
    FrameFont "MasterFont", 0.012, "",
    FontJustificationH JUSTIFYLEFT,
    FontJustificationV JUSTIFYBOTTOM,
    FontColor 1.0 1.0 1.0 1.0,
    FontShadowColor 0.0 0.0 0.0 0.9,
    FontShadowOffset 0.001 -0.001,
}
