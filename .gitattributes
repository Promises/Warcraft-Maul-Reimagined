# Auto detect text files and perform LF normalization
* text=auto
*.wts text eol=crlf
*.slk text eol=crlf
*.toc text eol=crlf
*.fdf text eol=crlf

*.j text eol=crlf
*.j linguist-language=TypeScript
./maps/* text eol=crlf

# patch-package files must stay LF; a CRLF checkout on Windows makes the patches fail to apply
*.patch text eol=lf
